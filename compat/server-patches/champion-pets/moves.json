      "ID": "1000004",
      "help": "提升能力",
      "des": "技能使用成功时，m%自身XX等级+/-n"
    },
    {
      "ID": "1000005",
      "help": "降低能力",
      "des": "技能使用成功时，m%对方XX等级+/-n"
